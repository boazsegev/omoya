                {
                  "label": "Continue",
                  "description": "Continue the UI tour.",
                  "preview": {
                    "type": "code",
                    "language": "js",
                    "title": "Continue",
                    "content": "// a code preview renders with syntax highlighting\nfunction advance() {\n  return tour.next();\n}"

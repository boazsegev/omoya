#!/usr/bin/env bun
/** Thin operator CLI: maps argv to the Jobs façade and prints short notes.
 * Problems are logged by the library in ai-jobs/errors/, not printed here. */
import { NAMES } from "../../lib/namespace.js";
import Jobs from "../../lib/jobs.js";
import { App } from "../../lib/app.js";
const { CLI } = App;

const name = `${NAMES.pr}-jobs`;
const help = `${name} — project-local Jobs
usage: ${name} <init|disable|status|run> [--model endpoint/model]
       ${name} --help
Actions also accept --init, --disable, --status, --run.
init      Enable local Jobs; idempotent. Never starts a daemon.
disable   Rename ai-jobs to ai-jobs-disabled preserving bytes; a prepared attempt may strand.
run       One best-effort scan; never initializes or repairs. Restore then scan reconciles stranded work without replay. Optional --model fallback.
status    Read-only folder and outcome projection (JSON); never starts a daemon.
Manual run and task CRUD do not require a daemon. Use the separate supervisor command for periodic scans.
No locks or singleton ownership exist: concurrent runs, CRUD, supervisors, archival and disable may duplicate work or lose updates.
Actions print short notes; problems and warnings are logged readably in ai-jobs/errors/YYYY-MM-DD.md (the scan record: ai-jobs/last-run.json, runs/). Failure/refusal exits 1, cancellation 130.
Tasks live in ai-jobs/tasks. Removing tasks does not cancel running work.
--help, -h, help  Show this text and exit.
`;
const note = (text) => process.stdout.write(`${name}: ${text}\n`);
const problem = (text) => process.stderr.write(`${name}: ${text}\n`);
/** A mistake in this script's own arguments — shown verbatim. */
class UsageError extends Error {}

function parse(args) {
  const result = {};
  for (let index = 0; index < args.length; index++) {
    const arg = args[index], action = arg.replace(/^--/, "");
    if (["init", "disable", "status", "run"].includes(action) && !result.action) result.action = action;
    else if (arg === "--model" && !result.model && args[index + 1] && !args[index + 1].startsWith("-")) result.model = args[++index];
    else throw new UsageError(`unknown flag or action: ${arg}`);
  }
  if (!result.action) throw new UsageError("expected one of init, disable, status, run");
  if (result.model && result.action !== "run") throw new UsageError("--model only applies to run");
  return result;
}
/** Run `fn(signal)` with Ctrl-C / SIGTERM mapped to cancellation. */
async function cancellable(fn) {
  const controller = new AbortController(), disarm = CLI.armCancelSignals({ onCancel: () => controller.abort() });
  try { return { value: await fn(controller.signal), cancelled: controller.signal.aborted }; }
  finally { disarm(); }
}
async function run(root, model) {
  const { value: { outcomes, errors, warnings, log }, cancelled } = await cancellable((signal) => Jobs.run(root, { execution: { signal, model } }));
  for (const { id, outcome } of outcomes) note(`${id}: ${outcome}`);
  if (!outcomes.length && !errors.length && !warnings.length) note("no jobs due");
  // The error log holds the details; if it could not be written, print them here.
  const counts = [errors.length ? `${errors.length} problem(s)` : "", warnings.length ? `${warnings.length} warning(s)` : ""].filter(Boolean).join(" and ");
  if (log) (errors.length ? problem : note)(`${counts} logged in ${log}`);
  else for (const item of [...errors, ...warnings]) problem(`${item.filename ?? item.id ?? "scan"}: ${item.code}: ${item.message}`);
  if (cancelled) note("cancelled");
  process.exitCode = cancelled ? CLI.EXIT.cancelled : errors.length ? 1 : 0;
}
async function disable(root) {
  const { state } = await Jobs.disable(root);
  note(state === "absent" ? "not initialized; nothing to disable" : state === "disabled" ? "already disabled" : "disabled (ai-jobs -> ai-jobs-disabled)");
}
async function status(root) {
  const result = await Jobs.status(root);
  for (const item of result.diagnostics) problem(`${item.code}: ${item.message}`);
  process.stdout.write(`${JSON.stringify(result)}\n`);
  if (result.eligibility.state !== "enabled") process.exitCode = 1;
}
async function main() {
  const args = process.argv.slice(2), root = process.cwd();
  if (!args.length || (args.length === 1 && ["--help", "-h", "help"].includes(args[0]))) { process.stdout.write(help); return; }
  const { action, model } = parse(args);
  if (action === "init") { await Jobs.init(root); note("enabled (ai-jobs/)"); }
  if (action === "disable") await disable(root);
  if (action === "run") await run(root, model);
  if (action === "status") await status(root);
}
try { await main(); }
catch (error) {
  problem(error instanceof UsageError ? `${error.message} (see --help)` : `${error.code ? `${error.code}: ` : ""}${error.message}`);
  process.exitCode = 1;
}

#!/usr/bin/env bun
/**
 * agent — headless tool-loop CLI (thin binding over lib/agent.js).
 *
 * Usage:
 *   <prefix>-agent [--model <endpoint>/<model>] [--url <url>]
 *            [--token <key>] [--timeout <dur>] [--tools <list>]
 *            [--session <id> | --resume <id>]
 *            [--login] [--logout <endpoint>] [--help]
 *
 * Contract:
 *   - Reads stdin to EOF (shared grammar: whole JSON context first,
 *     otherwise JSON-per-line with non-JSON lines as user messages).
 *   - Runs the Agent tool loop: provider request → tool calls executed
 *     in-process → results appended → next request, until done/error.
 *   - stdout: normalized response events, one JSON object per line
 *     (every request's events stream in order; the last done carries
 *     the final assembled message). stderr: diagnostics only.
 *   - --session <id> persists the context to a JSONL session log;
 *     --resume <id> replays it first. Session wiring lives in Agent.
 *   - SIGINT/SIGTERM cancels the in-flight request: the terminal
 *     partial is persisted, exit 130.
 *
 * Exit codes: 0 success · 1 usage/other · 2 auth · 3 network ·
 *             4 provider error · 5 malformed input · 130 cancelled
 */

import { basename } from "node:path";
import Agent from "../../lib/agent.js";
import { App } from "../../lib/app.js";
const { CLI } = App;
const { Env, IO, NAMES } = Agent;
const { ProviderError } = IO;
const { parseFlags, EXIT, exitCodeFor, readContextFromStdin, armCancelSignals, runLoginWizard, runMcpLogin, selectEndpointModel, adoptResumeOrigin, usageSummary } = CLI;

// The invoked name, like the TUI's: argv[1] holds the wrapper's file
// name; a bare `bun bin/scripts/agent` has none, so the namespace-
// derived prefix fills in (never a stale literal).
const NAME = basename(process.argv[1] ?? "") || `${NAMES.cliPrefix}-agent`;

const PROGRAM = "{{program}}";
const HELP_TEMPLATE = `${PROGRAM} — headless tool-loop CLI

usage: ${PROGRAM} [--model <endpoint>/<model>] [--url <url>]
                [--token <key>] [--timeout <dur>] [--tools <list>]
                [--session <id> | --resume <id>]
                [--login] [--mcp-login <name>]
                [--logout <endpoint>] [--help]

stdin:   one context, buffered to EOF (whole JSON context, else
         JSON-per-line; non-JSON lines become user messages)
stdout:  normalized response events, one JSON object per line —
         the tool loop streams every request's events in order;
         the last done carries the final assembled message
stderr:  diagnostics only (progress, tool executions, errors, usage)

options:
  --model <endpoint>/<model>  model id, optionally endpoint-prefixed; a
                              bare endpoint selects its first available
                              model (default endpoint: none unless selected)
  --url <url>          endpoint URL (overrides settings)
  --token <key>        auth token for this invocation only (never persisted)
  --timeout <dur>      overall cap per invocation (default 1048575ms);
                          a ms numeral or a unit string ("20m", "1h").
                          Hung-connection (connectTimeout 30s) and
                          stuck-model (stuckTimeout 120s) timeouts are
                          separate provider settings
  --tools <list>       tool availability: "*" or comma-separated names
                       (default: all discovered tools)
  --no-tool-fork      disable the tool sandbox: file tools run in-process
                       (default: forked — a crashing tool can't kill ${PROGRAM})
  --tool-timeout <dur> host override of settings.tools.timeout (default 120s);
                       a ms numeral or unit string ("30s", "5m"); a tool's
                       declared request is capped at tools.timeoutLimit (20m)
  --session <id>       persist under <settings>/${NAMES.sessionsDir}/
                       (the file name is date + sessionUUID + name — see
                       lib/agent/session.js; <id> stays the stable identity)
  --resume <id>        replay that session log first, then continue it
                       (an explicit id resumes anywhere: the cwd becomes the
                       session's own folder)
  --login              configure an endpoint with the interactive wizard, then exit
  --mcp-login <name>   sign in to a configured HTTP MCP server, then exit
  --logout <endpoint> remove an endpoint from settings.json and auth, then exit
  --help, -h           show this text and exit
  --max-turns, --max-tool-calls, --tool-async
                       unsupported; these flags fail instead of changing behavior

exit codes: 0 success · 1 usage/other · 2 auth · 3 network ·
            4 provider error · 5 malformed input · 130 cancelled`;

const HELP = HELP_TEMPLATE.replaceAll(PROGRAM, NAME);

const FLAGS = [
  "model", "url", "token", "timeout", "tools", "tool-timeout",
  "session", "resume", "max-turns", "max-tool-calls", "logout", "mcp-login",
];
const BOOL_FLAGS = ["no-tool-fork", "tool-async", "login"];

async function main() {
  let args;
  try {
    // Check the raw argv first: the shared parser short-circuits on --help.
    // An explicitly supplied unsupported flag must never be silently accepted.
    for (const argument of process.argv.slice(2)) {
      if (["--max-turns", "--max-tool-calls", "--tool-async"].includes(argument)) {
        throw new Error(`${argument} is unsupported: Agent has no turn/tool-call count or async tool-call mode`);
      }
    }
    args = parseFlags(process.argv.slice(2), { flags: FLAGS, bools: BOOL_FLAGS });
    if (args.session && args.resume) throw new Error("--session and --resume are mutually exclusive");
    if (typeof args.tools === "string" && args.tools !== "*") args.tools = args.tools.split(",").map((name) => name.trim()).filter(Boolean);
  } catch (err) {
    console.error(`${NAME}: ${err.message} (see --help)`);
    process.exit(EXIT.usage);
  }
  if (args.help) {
    console.log(HELP);
    process.exit(EXIT.ok);
  }

  const out = (event) => process.stdout.write(JSON.stringify(event) + "\n");
  const log = (line) => process.stderr.write(`${NAME}: ${line}\n`);

  // Resume-anywhere (lib/app/cli/resume.js): an explicit --resume <id>
  // continues the session in ITS recorded folder — adopted before the
  // environment is built.
  try {
    await adoptResumeOrigin({
      resume: args.resume,
      anonymous: ["0", "false", "anon"].includes(args.session),
    });
  } catch (err) {
    log(err.message);
    process.exit(EXIT.usage);
  }

  // Discover the endpoint without exposing invocation credentials to a shared Env.
  // The selection Env is released before the isolated override Env is acquired.
  const overrides = args.url !== undefined || args.token !== undefined || args.timeout !== undefined;
  if (overrides && (args.login || args.logout || args["mcp-login"])) {
    throw new Error("--url, --token and --timeout cannot be combined with login/logout commands");
  }
  let env = await Env.open(process.cwd());
  if (args["mcp-login"] || args.login || args.logout) {
    try {
      if (args["mcp-login"]) {
        const name = args["mcp-login"];
        await runMcpLogin(env, name);
        log(`MCP signed in: ${name}`);
      } else if (args.login) {
        const result = await runLoginWizard(env);
        log(`endpoint saved: ${result.name} (${result.endpoint.provider} at ${result.endpoint.url}, ${result.scope})`);
      } else {
        const result = env.logout(args.logout);
        log(`endpoint removed: ${result.name}${result.dynamic ? " (environment-defined — nothing was persisted)" : ""}`);
      }
      process.exitCode = EXIT.ok;
    } catch (err) {
      log(`${args.login ? "login" : args.logout ? "logout" : "MCP login"} failed: ${err.message}`);
      process.exitCode = EXIT.usage;
    } finally {
      await env.close();
    }
    return;
  }
  // Never pass --url into shared-Env selection: it may register an endpoint.
  // For a new qualified URL endpoint, configure its protocol on the isolated
  // Env and resolve there; existing endpoints retain their configured protocol.
  try {
    let selection = await selectEndpointModel(env, { model: args.model });
    const explicitEndpoint = args.url && typeof args.model === "string" && args.model.includes("/")
      ? args.model.slice(0, args.model.indexOf("/")) : undefined;
    const endpoint = selection?.slice(0, selection.indexOf("/")) ?? explicitEndpoint;
    if (overrides) {
      if (!endpoint || !/^[A-Za-z0-9][A-Za-z0-9_-]*$/.test(endpoint) || ["__proto__", "constructor", "prototype"].includes(endpoint)) {
        throw new Error(selection ? "--url, --token and --timeout require a resolvable endpoint" : "Please load a model with --model <endpoint>/<model> before using --url, --token or --timeout");
      }
      const known = env.settings.providers?.[endpoint];
      // Unknown endpoint names cannot be guessed from URL alone. A named
      // provider preset (such as ollama) supplies an explicit protocol.
      const preset = env.loginPresets().find((item) => item.name === endpoint);
      if (!known?.provider && !known?.url && !preset) throw new Error(`unknown endpoint ${JSON.stringify(endpoint)}; configure its provider first`);
      const provider = !known?.provider && !known?.url ? { provider: preset.provider ?? endpoint } : {};
      await env.close();
      env = await Env.open(process.cwd(), { settings: {
        providers: { [endpoint]: {
          ...provider,
          ...(args.url !== undefined ? { url: args.url } : {}),
          ...(args.token !== undefined ? { auth: { token: args.token } } : {}),
          ...(args.timeout !== undefined ? { timeout: args.timeout } : {}),
        } },
      }, init: { models: false } });
      selection = await selectEndpointModel(env, { model: selection ?? args.model });
    }
    args.model = selection;
    if (!args.model) throw new Error("Please load a model with --model <endpoint>/<model>");
  } catch (err) {
    log(err.message);
    await env.close();
    process.exitCode = EXIT.usage;
    return;
  }

  let context;
  try { context = await readContextFromStdin(); }
  catch (error) { await env.close(); throw error; }

  let agent;
  try {
    agent = await Agent.create({
      env,
      model: args.model,
      tools: args.tools,
      toolCall: {
        fork: !args["no-tool-fork"],
        timeout: args["tool-timeout"],
      },
      contextId: args.session ?? args.resume,
      context,
    });
    const responseEvents = [
      [Agent.EVENT.REQUEST_START, "start"], [Agent.EVENT.TEXT_START, "text_start"], [Agent.EVENT.TEXT_DELTA, "text_delta"], [Agent.EVENT.TEXT_END, "text_end"],
      [Agent.EVENT.THINKING_START, "thinking_start"], [Agent.EVENT.THINKING_DELTA, "thinking_delta"], [Agent.EVENT.THINKING_END, "thinking_end"],
      [Agent.EVENT.TOOL_CALL_START, "tool_call_start"], [Agent.EVENT.TOOL_CALL_DELTA, "tool_call_delta"], [Agent.EVENT.TOOL_CALL_END, "tool_call_end"],
      [Agent.EVENT.REQUEST_DONE, "done"], [Agent.EVENT.REQUEST_ERROR, "error"],
    ];
    for (const [event, type] of responseEvents) agent.onEvent(event, (value) => out({ type, ...value }));
    agent.onEvent(Agent.EVENT.LOG, log);
  } catch (err) {
    log(err.message);
    try { await agent?.close(); }
    finally { await env.close(); }
    process.exitCode = err instanceof ProviderError ? exitCodeFor({ kind: err.kind }) : EXIT.usage;
    return;
  }
  if (!agent.model) {
    log("no model selected; use --model or provider settings");
    try { await agent.close(); }
    finally { await env.close(); }
    process.exitCode = EXIT.usage;
    return;
  }

  // Cancellation: graceful async kill — the loop persists the partial
  // and returns the cancelled terminal; main maps it to exit 130.
  // (finish.js exit hooks remain the crash backstop; signals are NOT
  // armed here — the two signal paths must not fight.)
  const disarm = armCancelSignals({
    onCancel: (signal) => {
      log(`${signal} received; cancelling`);
      agent.cancel();
    },
  });

  let terminal;
  try {
    terminal = await agent.run();
  } finally {
    disarm();
    try { await agent.close(); }
    finally { await env.close(); }
  }
  if (terminal?.usage) log(usageSummary(terminal.usage));
  process.exitCode = exitCodeFor(terminal);
}

main().catch((err) => {
  console.error(`${NAME}: ${err?.message ?? err}`);
  process.exit(EXIT.usage);
});

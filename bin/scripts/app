#!/usr/bin/env bun
/** app — map command-line syntax into normalized application state. */
import { basename } from "node:path";
import AI from "../../lib/app.js";
import Env from "../../lib/env.js";
import { runMcpLogin } from "../../lib/app/cli/mcp-login.js";
import { runLoginWizard } from "../../lib/app/cli/login.js";
import { writeSettingsTemplate } from "../../lib/app/cli/init.js";
import { listEndpointModels } from "../../lib/app/shared/catalog.js";
import { formatHelp } from "./help.js";

const { App, NAMES } = AI;
const { CLI } = App;
// The invoked name: argv[1] holds the wrapper's file name; a bare
// `bun bin/scripts/app` has none, so the app's own command — the bare
// prefix — fills in (never a stale literal).
const program = basename(process.argv[1] ?? "") || NAMES.cliPrefix;
const valueFlags = ["model", "url", "token", "timeout", "tools", "tool-timeout", "session", "resume", "max-turns", "max-tool-calls", "input", "logout", "mcp-login", "screen", "port", "host"];
const booleanFlags = ["no-tool-fork", "tool-async", "safe", "login", "init", "force", "serve", "list"];

function sessionState(args) {
  if (["0", "false", "anon"].includes(args.session)) return { kind: "anonymous" };
  if (args.resume) return { kind: "resume", id: ["true", "latest"].includes(args.resume) ? "latest" : args.resume };
  return { kind: "new", id: args.session };
}

function launchState(args) {
  return {
    mode: args.screen,
    port: args.port === undefined ? 9900 : args.port,
    model: { model: args.model, url: args.url, token: args.token },
    session: sessionState(args),
    inputFile: args.input,
    timeout: args.timeout,
    can: { write: args.safe !== true },
    tools: {
      names: typeof args.tools === "string" && args.tools !== "*"
        ? args.tools.split(",").map((name) => name.trim()).filter(Boolean)
        : args.tools,
      call: { fork: !args["no-tool-fork"], timeout: args["tool-timeout"] },
    },
    input: process.stdin,
    output: process.stdout,
    diagnostics: process.stderr,
    signals: process,
  };
}

async function administrativeCommand(args) {
  const command = args["mcp-login"]
    ? { type: "mcpLogin", endpoint: args["mcp-login"] }
    : args.login
      ? { type: "login" }
    : args.logout
      ? { type: "logout", endpoint: args.logout }
      : args.init
        ? { type: "initialize", force: args.force === true }
        : args.list
          ? { type: "listModels" }
          : null;
  if (!command) return false;
  const env = await Env.open(process.cwd());
  try {
    if (command.type === "login") {
      const result = await runLoginWizard(env);
      process.stderr.write(`endpoint saved: ${result.name} (${result.endpoint.provider} at ${result.endpoint.url}, ${result.scope})\n`);
    } else if (command.type === "mcpLogin") {
      const result = await runMcpLogin(env, command.endpoint);
      process.stderr.write(`MCP signed in: ${result.name}\n`);
    } else if (command.type === "logout") {
      const result = env.logout(command.endpoint);
      process.stderr.write(`endpoint removed: ${result.name}${result.dynamic ? " (environment-defined — nothing was persisted)" : ""}\n`);
    } else if (command.type === "initialize") {
      process.stderr.write(`wrote ${writeSettingsTemplate(env, { force: command.force })}\n`);
    } else if (command.type === "listModels") {
      await env.modelsReady;
      for (const { name, models } of listEndpointModels(env)) {
        for (const model of models) process.stdout.write(`${name}/${model}\n`);
      }
    }
    return true;
  } finally {
    await CLI.close({ env });
  }
}

async function main() {
  const args = CLI.parseFlags(process.argv.slice(2), { flags: valueFlags, bools: booleanFlags, numbers: ["max-turns", "max-tool-calls"] });
  if (args.session && args.resume) throw new Error("--session and --resume are mutually exclusive");
  if (args.help) {
    process.stdout.write(`${formatHelp(program)}\n`);
    return;
  }
  for (const flag of ["max-turns", "max-tool-calls", "tool-async"]) {
    if (args[flag] !== undefined) throw new Error(`--${flag} is unsupported (no owning implementation)`);
  }
  if (await administrativeCommand(args)) return;
  if (args.serve) {
    const { serve } = App.Web;
    const web = await serve({ ...launchState(args), host: args.host });
    process.stderr.write(`web: ${web.url}\n`);
    await web.done;
    await web.stop();
    return;
  }
  const result = await App.TUI.run(launchState(args));
  // only a logged session has a file to resume
  if (result.session?.save) process.stderr.write(`session: ${result.session.id} (resume with: ${program} --resume ${result.session.id})\n`);
  else if (result.session) process.stderr.write(`session: ${result.session.summary}\n`);
  process.exitCode = result.code;
}

main().catch((error) => {
  process.stderr.write(`${program}: ${error?.message ?? error} (see --help)\n`);
  process.exit(CLI.EXIT.usage);
});

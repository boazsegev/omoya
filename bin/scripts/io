#!/usr/bin/env bun
/**
 * io — one-request provider CLI (thin binding over lib/io.js).
 *
 * Usage:
 *   <prefix>-io [--model <endpoint>/<model>] [--url <url>]
 *         [--token <key>] [--timeout <ms>] [--login] [--logout <endpoint>] [--help]
 *
 * Contract:
 *   - Reads stdin to EOF (shared grammar: whole JSON context first,
 *     otherwise JSON-per-line with non-JSON lines as user messages).
 *   - Makes exactly ONE provider request, streaming normalized response
 *     events as JSONL on stdout. Diagnostics only on stderr, never mixed.
 *   - Explicit arguments override settings; settings fill gaps. With no
 *     provider/ prefix, a single registered provider is selected implicitly.
 *   - SIGINT/SIGTERM cancels: the terminal partial event is emitted.
 *
 * Exit codes: 0 success · 1 usage/other · 2 auth · 3 network ·
 *             4 provider error · 5 malformed input · 130 cancelled
 */

import { basename } from "node:path";
import Agent from "../../lib/agent.js";
import { App } from "../../lib/app.js";
const { CLI } = App;
import Context from "../../lib/context.js";
const { Env, IO, NAMES } = Agent;
const { ProviderError } = IO;
const { parseFlags, EXIT, exitCodeFor, close, readContextFromStdin, armCancelSignals, runLoginWizard, runMcpLogin, selectEndpointModel, usageSummary } = CLI;

// The invoked name, like the TUI's: argv[1] holds the wrapper's file
// name; a bare `bun bin/scripts/io` has none, so the namespace-derived
// prefix fills in (never a stale literal).
const NAME = basename(process.argv[1] ?? "") || `${NAMES.cliPrefix}-io`;

const PROGRAM = "{{program}}";
const HELP_TEMPLATE = `${PROGRAM} — one-request provider CLI

usage: ${PROGRAM} [--model <endpoint>/<model>] [--url <url>]
             [--token <key>] [--timeout <dur>] [--login]
             [--mcp-login <name>] [--logout <endpoint>] [--help]

stdin:   one context, buffered to EOF (whole JSON context, else
         JSON-per-line; non-JSON lines become user messages)
stdout:  normalized response events, one JSON object per line
stderr:  diagnostics only (progress, errors, usage summary)

options:
  --model <endpoint>/<model>  model id, optionally endpoint-prefixed; a
                              bare endpoint selects its first available
                              model (default endpoint: none unless selected)
  --url <url>        endpoint URL (overrides settings)
  --token <key>      auth token for this invocation only (never persisted)
  --timeout <dur>    overall cap per request (default 1048575ms);
                     a ms numeral or a unit string ("20m", "1h").
                     Hung-connection (connectTimeout 30s) and stuck-model
                     (stuckTimeout 120s) timeouts are separate settings
  --login            configure an endpoint with the interactive wizard, then exit
  --mcp-login <name> sign in to a configured HTTP MCP server, then exit
  --logout <endpoint> remove an endpoint from settings.json and auth, then exit
  --help, -h         show this text and exit

exit codes: 0 success · 1 usage/other · 2 auth · 3 network ·
            4 provider error · 5 malformed input · 130 cancelled`;

const HELP = HELP_TEMPLATE.replaceAll(PROGRAM, NAME);

async function main() {
  let args;
  try {
    args = parseFlags(process.argv.slice(2), {
      flags: ["model", "url", "token", "timeout", "logout", "mcp-login"],
      bools: ["login"],
    });
  } catch (err) {
    console.error(`${NAME}: ${err.message} (see --help)`);
    process.exit(EXIT.usage);
  }
  if (args.help) {
    console.log(HELP);
    process.exit(EXIT.ok);
  }

  const out = (event) => process.stdout.write(JSON.stringify(event) + "\n");
  const log = (line) => process.stderr.write(`${NAME}: ${line}\n`);

  const overrides = args.url !== undefined || args.token !== undefined || args.timeout !== undefined;
  if (overrides && (args.login || args.logout || args["mcp-login"])) {
    throw new Error("--url, --token and --timeout cannot be combined with login/logout commands");
  }
  let env = await Env.open(process.cwd());
  if (args["mcp-login"] || args.login || args.logout) {
    try {
      if (args["mcp-login"]) {
        const name = args["mcp-login"];
        await runMcpLogin(env, name);
        log(`MCP signed in: ${name}`);
      } else if (args.login) {
        const result = await runLoginWizard(env);
        log(`endpoint saved: ${result.name} (${result.endpoint.provider} at ${result.endpoint.url}, ${result.scope})`);
      } else {
        const result = env.logout(args.logout);
        log(`endpoint removed: ${result.name}${result.dynamic ? " (environment-defined — nothing was persisted)" : ""}`);
      }
    } catch (err) {
      log(err.message);
      process.exitCode = EXIT.usage;
    } finally {
      await env.close();
    }
    return;
  }
  try {
    let selection = await selectEndpointModel(env, { model: args.model });
    const explicitEndpoint = args.url && typeof args.model === "string" && args.model.includes("/")
      ? args.model.slice(0, args.model.indexOf("/")) : undefined;
    const endpoint = selection?.slice(0, selection.indexOf("/")) ?? explicitEndpoint;
    if (overrides) {
      if (!endpoint || !/^[A-Za-z0-9][A-Za-z0-9_-]*$/.test(endpoint) || ["__proto__", "constructor", "prototype"].includes(endpoint)) {
        throw new Error(selection ? "--url, --token and --timeout require a resolvable endpoint" : "Please load a model with --model <endpoint>/<model> before using --url, --token or --timeout");
      }
      const known = env.settings.providers?.[endpoint];
      const preset = env.loginPresets().find((item) => item.name === endpoint);
      if (!known?.provider && !known?.url && !preset) throw new Error(`unknown endpoint ${JSON.stringify(endpoint)}; configure its provider first`);
      await env.close();
      env = await Env.open(process.cwd(), { settings: {
        providers: { [endpoint]: {
          ...(!known?.provider && !known?.url ? { provider: preset.provider } : {}),
          ...(args.url !== undefined ? { url: args.url } : {}),
          ...(args.token !== undefined ? { auth: { token: args.token } } : {}),
          ...(args.timeout !== undefined ? { timeout: args.timeout } : {}),
        } },
      }, init: { models: false } });
      selection = await selectEndpointModel(env, { model: selection ?? args.model });
    }
    args.model = selection;
    if (!args.model) throw new Error("Please load a model with --model <endpoint>/<model>");
  } catch (err) {
    log(err.message);
    await env.close();
    process.exitCode = EXIT.usage;
    return;
  }

  let aiio;
  try {
    aiio = new IO({
      env,
      model: args.model,
      onData: out,
      onLog: log,
    });
  } catch (err) {
    log(err.message);
    await env.close();
    process.exitCode = err instanceof ProviderError ? exitCodeFor({ kind: err.kind }) : EXIT.usage;
    return;
  }
  if (!aiio.model) {
    log("no model selected; use --model or provider settings");
    try { await aiio.close(); }
    finally { await env.close(); }
    process.exitCode = EXIT.usage;
    return;
  }

  const disarm = armCancelSignals({
    onCancel: (signal) => {
      log(`${signal} received; cancelling`);
      void aiio.close().catch((error) => log(error.message)).finally(() => { process.exitCode = EXIT.cancelled; });
    },
  });

  let terminal;
  try {
    const context = await readContextFromStdin();
    terminal = await aiio.write(new Context({ messages: context }));
  } finally {
    disarm();
    try { await aiio.close(); }
    finally { await close({ env }); }
  }
  if (terminal?.usage) log(usageSummary(terminal.usage));
  process.exitCode = exitCodeFor(terminal);
}

main().catch((err) => {
  console.error(`${NAME}: ${err?.message ?? err}`);
  process.exit(EXIT.usage);
});

#!/usr/bin/env bun
/** Generate direct shell commands for non-agent-specific tools. */
import { chmodSync, mkdirSync, readdirSync, readFileSync, rmSync, writeFileSync } from "node:fs";
import { basename, join } from "node:path";
import Agent from "../../lib/agent.js";
import CLI from "../../lib/cli.js";
const { Env, NAMES } = Agent;

// The invoked name: argv[1] holds the wrapper's file name; a bare
// `bun bin/scripts/tools2bash` has none, so the namespace-derived
// prefix fills in (never a stale literal).
const NAME = basename(process.argv[1] ?? "") || `${NAMES.cliPrefix}-tools2bash`;
const TOOL_CLI = `${NAMES.cliPrefix}-tool`; // the wrappers' exec target

const MARKER = "# generated by tools2bash";
const EXCLUDED = new Set(["tool-refresh", "bash", "read", "write", "edit", "question", "mcp"]);
const excluded = (name) => EXCLUDED.has(name) || name.startsWith("note-") || name.startsWith("chat-") || name.startsWith("mcp-");
const SHIM = `${MARKER}\nname=\${0##*/}\nexec ${TOOL_CLI} "$name" "$@"\n`;

async function main(argv) {
  if (argv.includes("--help") || argv.includes("-h")) {
    process.stdout.write(`Usage: ${NAME}\n\nGenerate direct ${TOOL_CLI} wrappers in $${NAMES.settingsEnv}/tools-bin.\n`);
    return 0;
  }
  if (argv.length) throw new Error(`unexpected argument: ${argv[0]}`);
  // Generate wrappers from the complete, asynchronously loaded tool registry.
  const env = await Env.create();
  const dir = join(env.settingsDir, "tools-bin");
  mkdirSync(dir, { recursive: true });
  const names = env.toolNames().filter((name) => name === "skill" || !excluded(name)).sort();
  const wanted = new Set(names);
  for (const entry of readdirSync(dir, { withFileTypes: true })) {
    if (!entry.isFile() || wanted.has(entry.name)) continue;
    const file = join(dir, entry.name);
    if (readFileSync(file, "utf8").includes(MARKER)) rmSync(file);
  }
  for (const name of names) {
    const file = join(dir, name);
    writeFileSync(file, SHIM, { mode: 0o755 });
    chmodSync(file, 0o755);
  }
  process.stdout.write(`${names.length} tool wrapper(s) written to ${dir}\n`);
  return 0;
}

let exitCode;
try {
  exitCode = await main(process.argv.slice(2));
} catch (error) {
  console.error(`${NAME}: ${error instanceof Error ? error.message : String(error)}`);
  exitCode = 1;
} finally {
  CLI.close();
}
process.exit(exitCode);
